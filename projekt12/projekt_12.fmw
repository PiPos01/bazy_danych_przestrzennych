# ============================================================================
DEFAULT_MACRO CSV2_IN_ATTRIBUTE_READING_CSV2_1 DEFLINE
CSV2_1_ATTRIBUTE_READING "$(CSV2_IN_ATTRIBUTE_READING_CSV2_1)"
# ============================================================================
CSV2_1_GENERATE_FME_BUILD_NUM 25810
CSV2_1_DATASET "$(SourceDataset_CSV2_1)"
