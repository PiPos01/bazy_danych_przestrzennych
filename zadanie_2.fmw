LOG_FILENAME "$(FME_MF_DIR)$(WORKSPACE_NAME).log"
LOG_APPEND NO
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING UTF-8
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "FME 2025.2.0.0 (20251120 - Build 25810 - WIN64)"
DEFAULT_MACRO DATASET_KEYWORD_TIFF_2 TIFF_2
DEFAULT_MACRO DATASET_KEYWORD_GEODATABASE_FILE_2 GEODATABASE_FILE_2
# -------------------------------------------------------------------------

TIFF_2_READER_META_ATTRIBUTES fme_feature_type fme_dataset fme_basename

# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

# -------------------------------------------------------------------------

MACRO FME_VIEWER_APP fmedatainspector
# -------------------------------------------------------------------------
TIFF_2_DEF TIFF
# -------------------------------------------------------------------------

FACTORY_DEF * RoutingFactory   FACTORY_NAME "Router and Unexpected Input Remover"   COMMAND_PARM_EVALUATION SINGLE_PASS   MULTI_READER_KEYWORD $(DATASET_KEYWORD_TIFF_2)   INPUT FEATURE_TYPE *    ROUTE TIFF TIFF_2::TIFF multi_reader_keyword,$(DATASET_KEYWORD_TIFF_2) TO FME_GENERIC ::TIFF ALIAS_GEOMETRY    MERGE_INPUT Yes   OUTPUT ROUTED FEATURE_TYPE *
TIFF_2_MERGE_DEF TIFF_2::TIFF EXACT TIFF
# -------------------------------------------------------------------------

FACTORY_DEF * TeeFactory    FACTORY_NAME "TIFF_TIFF_2 Splitter"    INPUT FEATURE_TYPE TIFF    OUTPUT FEATURE_TYPE TIFF_TIFF_2
DEFAULT_MACRO WB_CURRENT_CONTEXT
# -------------------------------------------------------------------------
FACTORY_DEF {*} ReprojectFactory    FACTORY_NAME { Reprojector_wgs84 }    INPUT  FEATURE_TYPE TIFF_TIFF_2    ENGINE { SOURCE "EPSG:27700" DESTINATION "LL-WGS84" }    INTERPOLATION_TYPE { NearestNeighbor }    RASTER_CELL_SIZE { PreserveCells }    RASTER_TOLERANCE { "0.0" }    OUTPUT { REPROJECTED FEATURE_TYPE Reprojector_wgs84_REPROJECTED          }    OUTPUT { REJECTED FEATURE_TYPE Reprojector_wgs84_<REJECTED>          }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME Reprojector_wgs84_<Rejected> INPUT FEATURE_TYPE Reprojector_wgs84_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, Reprojector_wgs84<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
# -------------------------------------------------------------------------
# Adds a prefix to existing attributes. This is done to ensure we don't
# overwrite any attributes when we add new ones.
Tcl2 proc RasterExtentsCoercer_prefixExistingAttributes {attrNames} {    set kAttrPrefix ".";    foreach oldName $attrNames {       set newName $kAttrPrefix;       append newName $oldName;       FME_RenameAttribute $newName $oldName;    }; };
# -------------------------------------------------------------------------
# Restores all previously prefixed attributes.
# This list of removed attributes should be kept in sync with those created
# by `@RasterProperties(RASTER)` and `@ProcessRasterTiles(DATAEXTENTS)`.
Tcl2 proc RasterExtentsCoercer_restorePrefixedAttributes {attrNames} {    FME_Execute RemoveAttributes _cell_origin_x _cell_origin_y _data_max_column _data_max_row _data_min_column _data_min_row _lower_left_x _lower_left_y _lower_right_x _lower_right_y _max_x _max_y _min_x _min_y _num_bands _num_columns _num_rows _origin_x _origin_y _rotation _spacing_x _spacing_y _upper_left_x _upper_left_y _upper_right_x _upper_right_y;    set kAttrPrefix ".";    foreach oldName $attrNames {       set newName $kAttrPrefix;       append newName $oldName;       FME_RenameAttribute $oldName $newName;    }; };
# -------------------------------------------------------------------------
# Replaces the existing geometry on a feature with a polygon.
Tcl2 proc RasterExtentsCoercer_replaceGeometryWithPolygon {ulx uly urx ury lrx lry llx lly} {    set comment {       Remove the existing geometry.    };    FME_Execute RemoveGeometry;    set comment {       Create the polygon.    };    FME_Coordinates addCoord $ulx $uly;    FME_Coordinates addCoord $urx $ury;    FME_Coordinates addCoord $lrx $lry;    FME_Coordinates addCoord $llx $lly;    FME_Coordinates addCoord $ulx $uly;    FME_Execute GeometryType fme_polygon;    FME_SetAttribute fme_type fme_area; };
# -------------------------------------------------------------------------
# Replaces the raster geometry with a polygon, using the rotated corners
# of the raster.
Tcl2 proc RasterExtentsCoercer_getRasterExtents {} {    set comment {       Retrieve the rotated extents.    };    set attrNames [FME_AttributeNames];    FME_Execute RenameAttributes FME_STRICT ___fme_rejection_code___ fme_rejection_code;    RasterExtentsCoercer_prefixExistingAttributes $attrNames;    FME_Execute RasterProperties REJECTABLE RASTER;    if {[string length [FME_GetAttribute {fme_rejection_code}]] == 0} {       set ulx [FME_GetAttribute _upper_left_x];       set uly [FME_GetAttribute _upper_left_y];       set urx [FME_GetAttribute _upper_right_x];       set ury [FME_GetAttribute _upper_right_y];       set lrx [FME_GetAttribute _lower_right_x];       set lry [FME_GetAttribute _lower_right_y];       set llx [FME_GetAttribute _lower_left_x];       set lly [FME_GetAttribute _lower_left_y];       set comment {          Create the extents polygon.       };       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;       RasterExtentsCoercer_replaceGeometryWithPolygon $ulx $uly $urx $ury $lrx $lry $llx $lly;    } else {       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;    } };
# -------------------------------------------------------------------------
# Replaces the raster geometry with a polygon, using the MBR extents of
# the data in the raster.
Tcl2 proc RasterExtentsCoercer_getDataMBRExtents {} {    set comment {       Get the raster properties and calculate the row/col data extents.    };    set attrNames [FME_AttributeNames];    FME_Execute RenameAttributes FME_STRICT ___fme_rejection_code___ fme_rejection_code;    RasterExtentsCoercer_prefixExistingAttributes $attrNames;    FME_Execute RasterProperties REJECTABLE RASTER;    FME_Execute ProcessRasterTiles REJECTABLE DATAEXTENTS;    if {[string length [FME_GetAttribute {fme_rejection_code}]] == 0} {       set originX [FME_GetAttribute _origin_x];       set originY [FME_GetAttribute _origin_y];       set spacingX [FME_GetAttribute _spacing_x];       set spacingY [FME_GetAttribute _spacing_y];       set minRow [FME_GetAttribute _data_min_row];       set minCol [FME_GetAttribute _data_min_column];       set maxRow [FME_GetAttribute _data_max_row];       set maxCol [FME_GetAttribute _data_max_column];       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;       set comment {          Calculate the extents in ground coordinates.       };       set minX [expr $originX + ($minCol*$spacingX)];       set maxX [expr $originX + (($maxCol+1)*$spacingX)];       set minY [expr $originY - (($maxRow+1)*$spacingY)];       set maxY [expr $originY - ($minRow*$spacingY)];       set comment {          Create the extents polygon.       };       RasterExtentsCoercer_replaceGeometryWithPolygon $minX $maxY $maxX $maxY $maxX $minY $minX $minY;    } else {       RasterExtentsCoercer_restorePrefixedAttributes $attrNames;    } };
INCLUDE [ if {{RasterExtents} == {RasterExtents}} {    puts {       FACTORY_DEF {*} TeeFactory          FACTORY_NAME { RasterExtentsCoercer_RasterExtents }          INPUT  FEATURE_TYPE Reprojector_wgs84_REPROJECTED          OUTPUT { FEATURE_TYPE ___TOREJECTOR___             @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)             @Tcl2("RasterExtentsCoercer_getRasterExtents") }    };    puts {       FACTORY_DEF {*} TestFactory          FACTORY_NAME { RasterExtentsCoercer_Rejector }          INPUT FEATURE_TYPE ___TOREJECTOR___          TEST @Value(fme_rejection_code) != ""          OUTPUT { PASSED FEATURE_TYPE RasterExtentsCoercer_<REJECTED>             @RemoveAttributes(___fme_rejection_code___)              }          OUTPUT { FAILED FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___)              }    }; } elseif {{RasterExtents} == {DataMBRExtents}} {    puts {       FACTORY_DEF {*} TeeFactory          FACTORY_NAME { RasterExtentsCoercer_DataMBRExtents }          INPUT  FEATURE_TYPE Reprojector_wgs84_REPROJECTED          OUTPUT FEATURE_TYPE ___TOREJECTOR___             @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)             @ApplyRasterRotation(REJECTABLE,NEARESTNEIGHBOR)             @Tcl2("RasterExtentsCoercer_getDataMBRExtents")    };    puts {       FACTORY_DEF {*} TestFactory          FACTORY_NAME { RasterExtentsCoercer_Rejector }          INPUT FEATURE_TYPE ___TOREJECTOR___          TEST @Value(fme_rejection_code) != ""          OUTPUT { PASSED FEATURE_TYPE RasterExtentsCoercer_<REJECTED>             @RemoveAttributes(___fme_rejection_code___)              }          OUTPUT { FAILED FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___)              }    }; } else {    puts {       FACTORY_DEF {*} TeeFactory          FACTORY_NAME { RasterExtentsCoercer_RasterIDGenerator }          INPUT  FEATURE_TYPE Reprojector_wgs84_REPROJECTED          OUTPUT { FEATURE_TYPE RasterExtentsCoercer_rasters_with_IDs             @SupplyAttributes(__rasterID__, @Count(RasterExtentsCoercer_COUNTER)) }    };    puts {       FACTORY_DEF {*} RasterSegmentationFactory          FACTORY_NAME { RasterExtentsCoercer_PolygonGenerator }          INPUT { FEATURE_TYPE RasterExtentsCoercer_rasters_with_IDs }          POLYGON_MODE NODATA          PRESERVE_ATTRIBUTES yes          REJECT_INVALID_FEATURES YES          POLYGON_LABEL_ATTRIBUTE __polygon_type__          OUTPUT { POLYGONS FEATURE_TYPE RasterExtentsCoercer_polygons }          OUTPUT { <REJECTED> FEATURE_TYPE RasterExtentsCoercer_<REJECTED>              }    };    puts {       FACTORY_DEF {*} TestFactory          FACTORY_NAME { RasterExtentsCoercer_NodataPolygonDiscarder }          INPUT { FEATURE_TYPE RasterExtentsCoercer_polygons }          TEST &__polygon_type__ == "data"          OUTPUT { PASSED FEATURE_TYPE RasterExtentsCoercer_data_polygons             @RemoveAttributes(__polygon_type__) }    };    puts {       FACTORY_DEF {*} AggregateFactory          FACTORY_NAME { RasterExtentsCoercer_DataPolygonAggregator }          INPUT { FEATURE_TYPE RasterExtentsCoercer_data_polygons }          GROUP_BY __rasterID__          BREAK_BEFORE_FIELD_CHANGE __rasterID__          ACCUMULATE_ATTRIBUTES yes          OUTPUT { AGGREGATE FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RemoveAttributes(__rasterID__)              }          OUTPUT { SINGLETON FEATURE_TYPE RasterExtentsCoercer_EXTENTS             @RemoveAttributes(__rasterID__)              }    }; }; ]
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME RasterExtentsCoercer_<Rejected> INPUT FEATURE_TYPE RasterExtentsCoercer_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, RasterExtentsCoercer<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Log<space>and<space>Troubleshoot<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "FilePropertyExtractor_2 Input Input Collector"   INPUT FEATURE_TYPE RasterExtentsCoercer_EXTENTS   OUTPUT FEATURE_TYPE FilePropertyExtractor_2_Input
MACRO FilePropertyExtractor_WORKSPACE_NAME FilePropertyExtractor_2
MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_XFORMER_NAME FilePropertyExtractor_2
MACRO $(FilePropertyExtractor_WORKSPACE_NAME)___COMPOUND_PARAMETERS 
MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_PATH <at>Value<openparen>fme_dataset<closeparen>
MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_FMT FME Date/Time (%Y%m%d%H%M%S)
MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_SUB_DOC_NAME FilePropertyExtractor
MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_SUB_DOC_NAME FilePropertyExtractor
DEFAULT_MACRO FilePropertyExtractor_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(FilePropertyExtractor_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(FilePropertyExtractor_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(FilePropertyExtractor_WORKSPACE_NAME)_Input1767807335 Input Splitter"   INPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Input"   OUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Input"
# -------------------------------------------------------------------------
Tcl2 proc $(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"__filepropertyextractor.path {$($(FilePropertyExtractor_WORKSPACE_NAME)_PATH)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Input"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
# -------------------------------------------------------------------------
FME_PYTHON_PATH "$(FME_MF_DIR)"
FACTORY_DEF {*} PythonFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_PythonCaller }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"    SYMBOL_NAME { extractFileProperty }    SOURCE_CODE { #<space>2016-05-25<comma><space>Takashi<space>Iijima<comma><space>Original<space>Implementation<lf>#<space>2020-01-28<comma><space>Takashi<space>Iijima<comma><space>Calculate<space>Directory<space>Size<space>as<space>Total<space>File<space>Sizes<space>under<space>the<space>Directory<semicolon><space>Changed<space>Default<space>Python<space>Interpreter<space>to<space>3.6+<lf><lf>import<space>fme<comma><space>fmeobjects<lf>import<space>os<lf>def<space>extractFileProperty<openparen>feature<closeparen>:<lf><space><space><space><space>def<space>get_dir_size<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space>total<space>=<space>0<lf><space><space><space><space><space><space><space><space>for<space>p<space>in<space>os.listdir<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>full_path<space>=<space>os.path.join<openparen>path<comma><space>p<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>os.path.isfile<openparen>full_path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>total<space>+=<space>os.path.getsize<openparen>full_path<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>elif<space>os.path.isdir<openparen>full_path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>total<space>+=<space>get_dir_size<openparen>full_path<closeparen><lf><space><space><space><space><space><space><space><space>return<space>total<lf><space><space><space><space>try:<lf><space><space><space><space><space><space><space><space>path<space>=<space>feature.getAttribute<openparen><apos>__filepropertyextractor.path<apos><closeparen><lf><space><space><space><space><space><space><space><space>if<space>os.path.exists<openparen>path<closeparen><space>and<space>not<space>os.path.islink<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space>s<space>=<space>os.stat<openparen>path<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space>os.path.isdir<openparen>path<closeparen>:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_type<apos><comma><space><apos>Directory<apos><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_size<apos><comma><space>get_dir_size<openparen>path<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>else:<lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_type<apos><comma><space><apos>File<apos><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_size<apos><comma><space>s.st_size<closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_atime<apos><comma><space>int<openparen>s.st_atime<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_mtime<apos><comma><space>int<openparen>s.st_mtime<closeparen><closeparen><lf><space><space><space><space><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>_file_ctime<apos><comma><space>int<openparen>s.st_ctime<closeparen><closeparen><lf><space><space><space><space><space><space><space><space>else:<lf><space><space><space><space><space><space><space><space><space><space><space><space>raise<space>Exception<openparen><apos>specified<space>file<solidus>directory<space>does<space>not<space>exist<apos><closeparen><lf><space><space><space><space>except<space>Exception<space>as<space>ex:<lf><space><space><space><space><space><space><space><space>feature.setAttribute<openparen><apos>__filepropertyextractor.error<apos><comma><space><apos>%s<apos><space>%<space>ex<closeparen> }    OUTPUT { PYOUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_PythonCaller_OUTPUT"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_Tester }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_PythonCaller_OUTPUT"    TEST { __filepropertyextractor.error ATTRIBUTE_IS_MISSING "" ENCODED }    BOOLEAN_OPERATOR  { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    OUTPUT { PASSED FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_FAILED"         }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_PASSED"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,__filepropertyextractor.path,__filepropertyextractor.error)        $($(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
# -------------------------------------------------------------------------
Tcl2 proc $(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_formatter {invalidValue} {       set dateFormat {$($(FilePropertyExtractor_WORKSPACE_NAME)_FMT)};       if { [string compare $dateFormat {FME Date/Time (%Y%m%d%H%M%S)}] == 0 } {          set dateFormat {%Y%m%d%H%M%S};       } elseif { [string compare $dateFormat {FME Date (%Y%m%d)}] == 0} {          set dateFormat {%Y%m%d};       } elseif { [string compare $dateFormat {FME Time (%H%M%S)}] == 0} {          set dateFormat {%H%M%S};       } elseif { [string compare $dateFormat {ISO Date (%Y-%m-%d)}] == 0} {          set dateFormat {%Y-%m-%d};       } elseif { [string compare $dateFormat {ISO DateTime (%Y-%m-%dT%H:%M:%S)}] == 0} {          set dateFormat {%Y-%m-%dT%H:%M:%S};       } elseif { [string compare $dateFormat {ISO Time (%H:%M:%S)}] == 0} {          set dateFormat {%H:%M:%S};       } elseif { [string compare $dateFormat {Locale Date (%c)}] == 0} {          set dateFormat {%c};       };     set attrs [split {_file_ctime,_file_mtime,_file_atime} {,}];     foreach attr $attrs {        set date [string trim [FME_GetAttribute $attr]];        set comment { Don't touch NULL or empty attribute values };        if { [string length $date] == 0 } { continue; };        set srcfmt {};        if {{%s} != {FME_AUTOMATIC}} {            set srcfmt {%s};        } else {           set comment { In Automatic mode we ignore the millisecond part };           regexp {^[^.]*} $date date;           set comment { Treat single char as invalid date };           if { [regexp {^.$} $date] } {              set date {};           };        };        set comment { An empty $date at this point is invalid, so don't process further };        set dateLen [string length $date];        if {$dateLen > 0} {           if {[string length $srcfmt] == 0} {              set attrFull $attr;              append attrFull .full;              set fullDate [FME_GetAttribute $attrFull];              if { [string compare -length $dateLen $date $fullDate] == 0 } {                 set extra [string range $fullDate $dateLen end]000000;                 set date [string range \"$date$extra\" 0 13];                 set dateLen 14              };              if {($dateLen == 14) && [regexp {^[0-9]*$} $date]} {                 set srcfmt %Y%m%d%H%M%S;              };           };           set sourceFormatOpt {};           if {[string length $srcfmt] > 0} {              set sourceFormatOpt \"-format {$srcfmt}\";           };           set comment { Compute the output value and catch any errors };           set error [catch { set seconds [eval clock scan "{$date}" $sourceFormatOpt];                              set output [clock format $seconds -format $dateFormat];           }];           set comment { If there was error then we try again by removing digits after last decimal };           if { $error != 0 } {              set index [string last "." $date];              if { $index > 0 } {                 set date [eval string range $date 0 [expr $index-1]];                 set dateLen [string length $date];                 set error [catch { set seconds [eval clock scan "{$date}" $sourceFormatOpt]; set output [clock format $seconds -format $dateFormat]; }];              };           };           if { $error == 0 } {              FME_SetAttribute $attr $output;           };        };        if { (0 == $dateLen) || ($error != 0) } {          if { $invalidValue == {FME_NULL_VALUE} } {             FME_SetAttributeNull $attr;          } elseif { $invalidValue != {_FME_NO_OP_} }  {             FME_SetAttribute $attr [FME_DecodeText $invalidValue];          };        };     }; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_OUTPUT"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_OUTPUT"         @Tcl2("$(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_formatter {_FME_NO_OP_}")          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC }    } else {        puts "MACRO $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2 }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Tester_FAILED"    OUTPUT { FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT"        @RemoveAttributes(fme_encoded,_file_size,_file_type,_file_ctime,__filepropertyextractor.path,_file_mtime,_file_atime)        $($(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRenamer }    INPUT  FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRemover_2_OUTPUT" 	 ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV 	 ATTR_ACTION { "__filepropertyextractor.error" "_rejected_reason" "RENAME_SET_DEFAULT" "" }    OUTPUT { OUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRenamer_OUTPUT"        }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(FilePropertyExtractor_WORKSPACE_NAME)_Output1767807335 Output Collector"   INPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_DateFormatter_OUTPUT"   OUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_Output"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(FilePropertyExtractor_WORKSPACE_NAME)_<Rejected>1767807335 Output Collector"   INPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_AttributeRenamer_OUTPUT"   OUTPUT FEATURE_TYPE "$(FilePropertyExtractor_WORKSPACE_NAME)_<Rejected>"
