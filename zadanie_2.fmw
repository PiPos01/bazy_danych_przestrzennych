#! END_WB_HEADER
#! START_WB_HEADER
MACRO WB_KEYWORD "TIFF_2"
#! END_WB_HEADER
#! START_SOURCE_HEADER TIFF TIFF_2
# =======================================================================
# The following GUI line prompts for a file to be used as the source TIF file.
# The user input is stored in a macro, which is then used to define
# the dataset to be read.
# The dataset this mapping file was generated from was:
#! END_SOURCE_HEADER
#! START_WB_HEADER
DEFAULT_MACRO SourceDataset
INCLUDE [ if {{$(SourceDataset)} != ""} {                        \
 puts {DEFAULT_MACRO SourceDataset_TIFF_2 $(SourceDataset)}     \
 } ]
#! END_WB_HEADER
#! START_SOURCE_HEADER TIFF TIFF_2
DEFAULT_MACRO SourceDataset_TIFF_2 $(SourceDataset_TIFF_3)
GUI MULTIFILE SourceDataset_TIFF_2 TIFF_Files(*.tif;*.tiff;*.itiff;*.ovr)|*.tif;*.tiff;*.itiff;*.ovr|TIFF_Files(*.tif)|*.tif|TIFF_Files(*.tiff)|*.tiff|TIFF_Files(*.itiff)|*.itiff|Overview_Files(*.ovr)|*.ovr|All_Files(*)|* Source TIFF (Tagged Image File Format) File(s):
DEFAULT_MACRO TIFF_IN_READER_META_ATTRIBUTES_TIFF_2 fme_dataset fme_basename
TIFF_2_READER_META_ATTRIBUTES "$(TIFF_IN_READER_META_ATTRIBUTES_TIFF_2)"
DEFAULT_MACRO TIFF_IN_FEATURE_TYPE_NAME_TIFF_2 FORMAT_NAME
TIFF_2_FEATURE_TYPE_NAME "$(TIFF_IN_FEATURE_TYPE_NAME_TIFF_2)"
DEFAULT_MACRO TIFF_IN_EXPOSE_ATTRS_GROUP_TIFF_2 
TIFF_2_EXPOSE_ATTRS_GROUP "$(TIFF_IN_EXPOSE_ATTRS_GROUP_TIFF_2)"
DEFAULT_MACRO TIFF_IN_SPATIAL_GROUP_TIFF_2 
GUI OPTIONAL DISCLOSUREGROUP TIFF_IN_SPATIAL_GROUP_TIFF_2 TIFF_IN_COORDINATE_SYSTEM_TIFF_2%TIFF_IN_USE_SEARCH_ENVELOPE_TIFF_2 Spatial
DEFAULT_MACRO TIFF_IN_COORDINATE_SYSTEM_TIFF_2 
TIFF_2_COORDINATE_SYSTEM "$(TIFF_IN_COORDINATE_SYSTEM_TIFF_2)"
GUI OPTIONAL COORDSYS TIFF_IN_COORDINATE_SYSTEM_TIFF_2 Coordinate System:
# Include this file in source setting section to add external search envelope processing
# Zero as a default means we don't do any search -- this makes workbench happier
DEFAULT_MACRO TIFF_IN_USE_SEARCH_ENVELOPE_TIFF_2 NO
TIFF_2_USE_SEARCH_ENVELOPE "$(TIFF_IN_USE_SEARCH_ENVELOPE_TIFF_2)"
GUI ACTIVEDISCLOSUREGROUP TIFF_IN_USE_SEARCH_ENVELOPE_TIFF_2 TIFF_IN_SEARCH_ENVELOPE_MINX_TIFF_2%TIFF_IN_SEARCH_ENVELOPE_MINY_TIFF_2%TIFF_IN_SEARCH_ENVELOPE_MAXX_TIFF_2%TIFF_IN_SEARCH_ENVELOPE_MAXY_TIFF_2%TIFF_IN_SEARCH_ENVELOPE_COORDINATE_SYSTEM_TIFF_2%TIFF_IN_CLIP_TO_ENVELOPE_TIFF_2%TIFF_IN_SEARCH_METHOD%TIFF_IN_SEARCH_METHOD_FILTER%TIFF_IN_SEARCH_ORDER%TIFF_IN_SEARCH_FEATURE%TIFF_IN_DUMMY_SEARCH_ENVELOPE_PARAMETER Use Search Envelope
# ===========================================================================
GUI LOOKUP TIFF_IN_SEARCH_ENVELOPE_MINX_TIFF_2 <Unused>,0 
DEFAULT_MACRO TIFF_IN_SEARCH_ENVELOPE_MINX_TIFF_2 0
TIFF_2_SEARCH_ENVELOPE "$(TIFF_IN_SEARCH_ENVELOPE_MINX_TIFF_2)"
GUI OPTIONAL FLOAT TIFF_IN_SEARCH_ENVELOPE_MINX_TIFF_2 Minimum X:
# ===========================================================================
GUI LOOKUP TIFF_IN_SEARCH_ENVELOPE_MINY_TIFF_2 <Unused>,0 
DEFAULT_MACRO TIFF_IN_SEARCH_ENVELOPE_MINY_TIFF_2 0
TIFF_2_SEARCH_ENVELOPE "$(TIFF_IN_SEARCH_ENVELOPE_MINY_TIFF_2)"
GUI OPTIONAL FLOAT TIFF_IN_SEARCH_ENVELOPE_MINY_TIFF_2 Minimum Y:
# ===========================================================================
GUI LOOKUP TIFF_IN_SEARCH_ENVELOPE_MAXX_TIFF_2 <Unused>,0 
DEFAULT_MACRO TIFF_IN_SEARCH_ENVELOPE_MAXX_TIFF_2 0
TIFF_2_SEARCH_ENVELOPE "$(TIFF_IN_SEARCH_ENVELOPE_MAXX_TIFF_2)"
GUI OPTIONAL FLOAT TIFF_IN_SEARCH_ENVELOPE_MAXX_TIFF_2 Maximum X:
# ===========================================================================
GUI LOOKUP TIFF_IN_SEARCH_ENVELOPE_MAXY_TIFF_2 <Unused>,0 
DEFAULT_MACRO TIFF_IN_SEARCH_ENVELOPE_MAXY_TIFF_2 0
TIFF_2_SEARCH_ENVELOPE "$(TIFF_IN_SEARCH_ENVELOPE_MAXY_TIFF_2)"
GUI OPTIONAL FLOAT TIFF_IN_SEARCH_ENVELOPE_MAXY_TIFF_2 Maximum Y:
# ===========================================================================
GUI LOOKUP TIFF_IN_SEARCH_ENVELOPE_COORDINATE_SYSTEM_TIFF_2 <Unused>, 
DEFAULT_MACRO TIFF_IN_SEARCH_ENVELOPE_COORDINATE_SYSTEM_TIFF_2 
TIFF_2_SEARCH_ENVELOPE "$(TIFF_IN_SEARCH_ENVELOPE_COORDINATE_SYSTEM_TIFF_2)"
GUI OPTIONAL COORDSYS TIFF_IN_SEARCH_ENVELOPE_COORDINATE_SYSTEM_TIFF_2 Search Envelope Coordinate System:
# ===========================================================================
# BUG18999: We now have a soft clip to fall back on like native spatial index
# thus we are reintroducing the clip to envelop as an option for users.
# Defualt to soft clip as per the existing database readers we are emulating
GUI LOOKUP TIFF_IN_CLIP_TO_ENVELOPE_TIFF_2 <Unused>,NO 
DEFAULT_MACRO TIFF_IN_CLIP_TO_ENVELOPE_TIFF_2 NO
TIFF_2_CLIP_TO_ENVELOPE "$(TIFF_IN_CLIP_TO_ENVELOPE_TIFF_2)"
GUI OPTIONAL CHECKBOX TIFF_IN_CLIP_TO_ENVELOPE_TIFF_2 YES%NO Clip to Search Envelope
DEFAULT_MACRO TIFF_IN_TIFF_RDR_ADV_PARM_GROUP_TIFF_2 
GUI OPTIONAL DISCLOSUREGROUP TIFF_IN_TIFF_RDR_ADV_PARM_GROUP_TIFF_2 TIFF_IN_PYRAMID_LEVEL_TIFF_2%TIFF_IN_SCALE_COLOR_TO_STANDARD_BIT_DEPTH_TIFF_2 Advanced
DEFAULT_MACRO TIFF_IN_PYRAMID_LEVEL_TIFF_2 
TIFF_2_PYRAMID_LEVEL "$(TIFF_IN_PYRAMID_LEVEL_TIFF_2)"
GUI OPTIONAL INTEGER TIFF_IN_PYRAMID_LEVEL_TIFF_2 Pyramid Level to Read:
DEFAULT_MACRO TIFF_IN_SCALE_COLOR_TO_STANDARD_BIT_DEPTH_TIFF_2 YES
TIFF_2_SCALE_COLOR_TO_STANDARD_BIT_DEPTH "$(TIFF_IN_SCALE_COLOR_TO_STANDARD_BIT_DEPTH_TIFF_2)"
GUI LOOKUP_CHOICE TIFF_IN_SCALE_COLOR_TO_STANDARD_BIT_DEPTH_TIFF_2 "\"Scale to Standard Bit Depth\",YES"%"\"Do Not Scale\",NO" Non-standard Color Bit Depth:
DEFAULT_MACRO TIFF_IN_LENIENT_READ_TIFF_2 Yes
TIFF_2_LENIENT_READ "$(TIFF_IN_LENIENT_READ_TIFF_2)"
# ===========================================================================
DEFAULT_MACRO TIFF_IN_NETWORK_AUTHENTICATION_TIFF_2 
TIFF_2_NETWORK_AUTHENTICATION "$(TIFF_IN_NETWORK_AUTHENTICATION_TIFF_2)"
GUI OPTIONAL AUTHENTICATOR TIFF_IN_NETWORK_AUTHENTICATION_TIFF_2 CONTAINER%GROUP%CONTAINER_TITLE%"Network Authentication"%PROMPT_TYPE%NETWORK Network Authentication
# ============================================================================
DEFAULT_MACRO TIFF_IN_ATTRIBUTE_READING_TIFF_2 ALL
TIFF_2_ATTRIBUTE_READING "$(TIFF_IN_ATTRIBUTE_READING_TIFF_2)"
# ============================================================================
TIFF_2_GENERATE_FME_BUILD_NUM 25810
TIFF_2_DATASET "$(SourceDataset_TIFF_2)"
#! END_SOURCE_HEADER
#! START_WB_HEADER
MACRO WB_KEYWORD "GEODATABASE_FILE_2"
#! END_WB_HEADER
#! START_DEST_HEADER GEODATABASE_FILE GEODATABASE_FILE_2
# ============================================================================
# The following GUI line prompts for a folder to be used as the
# the destination for the GEODB files.
# The user input is stored in a macro, which is then used to define
# the dataset to be written.
GUI SOURCE_GEODATABASE DestDataset_GEODATABASE_FILE_2 File Geodatabase:
DEFAULT_MACRO GEODATABASE_FILE_OUT_FME_CONNECTION_GROUP_GEODATABASE_FILE_2 
GUI OPTIONAL DISCLOSUREGROUP GEODATABASE_FILE_OUT_FME_CONNECTION_GROUP_GEODATABASE_FILE_2 GEODATABASE_FILE_OUT_DATASET%GEODATABASE_FILE_OUT_NAMED_CONNECTION%GEODATABASE_FILE_OUT_OVERWRITE_GEODB_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_IMPORT_XML_TEMPLATE_GROUP_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_TRANSACTION_TYPE_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_FEATURE_DATASET_HANDLING_GEODATABASE_FILE_2 Database Connection
# ============================================================================
# Determines if dataset has to be overwritten
DEFAULT_MACRO GEODATABASE_FILE_OUT_OVERWRITE_GEODB_GEODATABASE_FILE_2 NO
GEODATABASE_FILE_2_OVERWRITE_GEODB "$(GEODATABASE_FILE_OUT_OVERWRITE_GEODB_GEODATABASE_FILE_2)"
GUI ACTIVEDISCLOSUREGROUP GEODATABASE_FILE_OUT_OVERWRITE_GEODB_GEODATABASE_FILE_2 FME_DISCLOSURE_OPEN%GEODATABASE_FILE_OUT_DATASET_TEMPLATE_GEODATABASE_FILE_2 Overwrite Existing Geodatabase
DEFAULT_MACRO GEODATABASE_FILE_OUT_DATASET_TEMPLATE_GEODATABASE_FILE_2 
GEODATABASE_FILE_2_DATASET_TEMPLATE "$(GEODATABASE_FILE_OUT_DATASET_TEMPLATE_GEODATABASE_FILE_2)"
GUI OPTIONAL SOURCE_GEODATABASE_CFG GEODATABASE_FILE_OUT_DATASET_TEMPLATE_GEODATABASE_FILE_2 SWIZZLER:NO Template File Geodatabase
GUI LOOKUP GEODATABASE_FILE_OUT_DATASET_TEMPLATE_GEODATABASE_FILE_2 <Unused>, 
# ============================================================================__
# Contains options relating to importing XML template files.
DEFAULT_MACRO GEODATABASE_FILE_OUT_IMPORT_XML_TEMPLATE_GROUP_GEODATABASE_FILE_2 NO
GEODATABASE_FILE_2_IMPORT_XML_TEMPLATE_GROUP "$(GEODATABASE_FILE_OUT_IMPORT_XML_TEMPLATE_GROUP_GEODATABASE_FILE_2)"
GUI ACTIVEDISCLOSUREGROUP GEODATABASE_FILE_OUT_IMPORT_XML_TEMPLATE_GROUP_GEODATABASE_FILE_2 GEODATABASE_FILE_OUT_TEMPLATEFILE_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_IMPORT_KIND_GEODATABASE_FILE_2 Import XML Workspace Document
# ============================================================================__
# Optional template file can be specified. This will load the schema
# of the template file into the database before any writing occurs.
DEFAULT_MACRO GEODATABASE_FILE_OUT_TEMPLATEFILE_GEODATABASE_FILE_2 <Unused>
GEODATABASE_FILE_2_TEMPLATEFILE "$(GEODATABASE_FILE_OUT_TEMPLATEFILE_GEODATABASE_FILE_2)"
GUI OPTIONAL FILENAME_MUSTEXIST GEODATABASE_FILE_OUT_TEMPLATEFILE_GEODATABASE_FILE_2 XML_Geodatabase_Files(*.xml)|*.xml|(*.zip)|*.zip|(*.z)|*.z|All_files(*)|* XML Workspace Document:
# ============================================================================__
# FMEENGINE-10409
# Add option to import data from template, rather than just the schema.
DEFAULT_MACRO GEODATABASE_FILE_OUT_IMPORT_KIND_GEODATABASE_FILE_2 <Unused>
GEODATABASE_FILE_2_IMPORT_KIND "$(GEODATABASE_FILE_OUT_IMPORT_KIND_GEODATABASE_FILE_2)"
GUI CHOICE_ENCODED GEODATABASE_FILE_OUT_IMPORT_KIND_GEODATABASE_FILE_2 Schema<space>Only%Data<space>and<space>Schema Import
# ============================================================================
# This option specifies the transaction type. This should be set to EDIT_SESSION
# when edits are made to tables/feature classes that have custom behaviour
# associated with them - i.e. when writing to feature classes that are involved
# in relationships. Both TRANSACTIONS and NONE can be chosen only when writing
# to tables/feature classes that do not have custom behaviour.
DEFAULT_MACRO GEODATABASE_FILE_OUT_TRANSACTION_TYPE_GEODATABASE_FILE_2 TRANSACTIONS
GEODATABASE_FILE_2_TRANSACTION_TYPE "$(GEODATABASE_FILE_OUT_TRANSACTION_TYPE_GEODATABASE_FILE_2)"
GUI LOOKUP_CHOICE GEODATABASE_FILE_OUT_TRANSACTION_TYPE_GEODATABASE_FILE_2 Edit<space>Session,EDIT_SESSION%Transactions,TRANSACTIONS%None,NONE Transaction Type:
# ============================================================================__
# Specifies how the writer should handle feature datasets whether set on the feature type or the feature
DEFAULT_MACRO GEODATABASE_FILE_OUT_FEATURE_DATASET_HANDLING_GEODATABASE_FILE_2 WRITE
GEODATABASE_FILE_2_FEATURE_DATASET_HANDLING "$(GEODATABASE_FILE_OUT_FEATURE_DATASET_HANDLING_GEODATABASE_FILE_2)"
GUI LOOKUP_CHOICE GEODATABASE_FILE_OUT_FEATURE_DATASET_HANDLING_GEODATABASE_FILE_2 Write<space>Feature<space>Dataset,WRITE%Warn<space>and<space>Ignore<space>Feature<space>Dataset,IGNORE%Error<space>and<space>End<space>Translation,END%Off<space>-<space>Slashes<space>become<space>underscores,OFF Feature Dataset Handling:
DEFAULT_MACRO GEODATABASE_FILE_OUT_SPATIAL_GROUP_GEODATABASE_FILE_2 
GUI OPTIONAL DISCLOSUREGROUP GEODATABASE_FILE_OUT_SPATIAL_GROUP_GEODATABASE_FILE_2 GEODATABASE_FILE_OUT_COORDINATE_SYSTEM_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_SPATIAL_SETTINGS_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_DEFAULT_Z_VALUE_GEODATABASE_FILE_2 Spatial
DEFAULT_MACRO GEODATABASE_FILE_OUT_COORDINATE_SYSTEM_GEODATABASE_FILE_2 
GEODATABASE_FILE_2_COORDINATE_SYSTEM "$(GEODATABASE_FILE_OUT_COORDINATE_SYSTEM_GEODATABASE_FILE_2)"
GUI OPTIONAL COORDSYS GEODATABASE_FILE_OUT_COORDINATE_SYSTEM_GEODATABASE_FILE_2 Coordinate System:
DEFAULT_MACRO GEODATABASE_FILE_OUT_SPATIAL_SETTINGS_GEODATABASE_FILE_2 
GUI OPTIONAL DISCLOSUREGROUP GEODATABASE_FILE_OUT_SPATIAL_SETTINGS_GEODATABASE_FILE_2 GEODATABASE_FILE_OUT_SIMPLIFY_GEOM_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_HAS_Z_VALUES_GEODATABASE_FILE_2 Geometry
# ============================================================================
# Specifies if the geomtery is to be simplified or not. Default is no
DEFAULT_MACRO GEODATABASE_FILE_OUT_SIMPLIFY_GEOM_GEODATABASE_FILE_2 No
GEODATABASE_FILE_2_SIMPLIFY_GEOM "$(GEODATABASE_FILE_OUT_SIMPLIFY_GEOM_GEODATABASE_FILE_2)"
GUI LOOKUP_CHOICE GEODATABASE_FILE_OUT_SIMPLIFY_GEOM_GEODATABASE_FILE_2 Yes%No Simplify Geometry:
DEFAULT_MACRO GEODATABASE_FILE_OUT_X_ORIGIN_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_X_ORIGIN "$(GEODATABASE_FILE_OUT_X_ORIGIN_GEODATABASE_FILE_2)"
DEFAULT_MACRO GEODATABASE_FILE_OUT_Y_ORIGIN_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_Y_ORIGIN "$(GEODATABASE_FILE_OUT_Y_ORIGIN_GEODATABASE_FILE_2)"
DEFAULT_MACRO GEODATABASE_FILE_OUT_XY_SCALE_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_XY_SCALE "$(GEODATABASE_FILE_OUT_XY_SCALE_GEODATABASE_FILE_2)"
# ============================================================================
# Determines if dataset contains Z values. This value will be used if DEF lines
# don't have anything set. The auto_detect option will use the first feature
# headed for each feature class to determine whether the feature class should be
# 2D or 3D.
DEFAULT_MACRO GEODATABASE_FILE_OUT_HAS_Z_VALUES_GEODATABASE_FILE_2 auto_detect
GEODATABASE_FILE_2_HAS_Z_VALUES "$(GEODATABASE_FILE_OUT_HAS_Z_VALUES_GEODATABASE_FILE_2)"
GUI LOOKUP_CHOICE GEODATABASE_FILE_OUT_HAS_Z_VALUES_GEODATABASE_FILE_2 Yes,yes%No,no%Auto<space>Detect,auto_detect Contains Z Values:
DEFAULT_MACRO GEODATABASE_FILE_OUT_Z_ORIGIN_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_Z_ORIGIN "$(GEODATABASE_FILE_OUT_Z_ORIGIN_GEODATABASE_FILE_2)"
DEFAULT_MACRO GEODATABASE_FILE_OUT_Z_SCALE_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_Z_SCALE "$(GEODATABASE_FILE_OUT_Z_SCALE_GEODATABASE_FILE_2)"
DEFAULT_MACRO GEODATABASE_FILE_OUT_GRID_1_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_GRID_1 "$(GEODATABASE_FILE_OUT_GRID_1_GEODATABASE_FILE_2)"
GUI LOOKUP GEODATABASE_FILE_OUT_Z_ORIGIN_GEODATABASE_FILE_2 <Unused>,0 
GUI LOOKUP GEODATABASE_FILE_OUT_Z_SCALE_GEODATABASE_FILE_2 <Unused>,0 
# ============================================================================
# Determines default Z value
DEFAULT_MACRO GEODATABASE_FILE_OUT_DEFAULT_Z_VALUE_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_DEFAULT_Z_VALUE "$(GEODATABASE_FILE_OUT_DEFAULT_Z_VALUE_GEODATABASE_FILE_2)"
GUI FLOAT GEODATABASE_FILE_OUT_DEFAULT_Z_VALUE_GEODATABASE_FILE_2 Default Z Value:
DEFAULT_MACRO GEODATABASE_FILE_OUT_GEODB_SHARED_WRT_ADV_PARM_GROUP_GEODATABASE_FILE_2 
GUI OPTIONAL DISCLOSUREGROUP GEODATABASE_FILE_OUT_GEODB_SHARED_WRT_ADV_PARM_GROUP_GEODATABASE_FILE_2 GEODATABASE_FILE_OUT_REQUESTED_GEODATABASE_VERSION_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_TRANSACTION_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_TRANSACTION_INTERVAL_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_IGNORE_FAILED_FEATURE_ENTRY_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_MAX_NUMBER_FAILED_FEATURES_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_DUMP_FAILED_FEATURES_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_FFS_DUMP_FILE_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_ANNOTATION_UNITS_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_HAS_MEASURES_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_MEASURES_ORIGIN%GEODATABASE_FILE_OUT_MEASURES_SCALE%GEODATABASE_FILE_OUT_COMPRESS_AT_END_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_ENABLE_FAST_DELETES_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_PRESERVE_GLOBALID_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_ENABLE_LOAD_ONLY_MODE_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_RELATIONSHIP_WRITE_OVERRIDE_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_VALIDATE_FEATURES_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_SIMPLIFY_NETWORK_FEATURES_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_BEGIN_SQL{0}_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_END_SQL{0}_GEODATABASE_FILE_2%GEODATABASE_FILE_OUT_ALWAYS_CREATE_FEATURE_TYPES_GEODATABASE_FILE_2 Advanced
# ============================================================================
# Determines version of geodatabase to create
DEFAULT_MACRO GEODATABASE_FILE_OUT_REQUESTED_GEODATABASE_VERSION_GEODATABASE_FILE_2 CURRENT
GEODATABASE_FILE_2_REQUESTED_GEODATABASE_VERSION "$(GEODATABASE_FILE_OUT_REQUESTED_GEODATABASE_VERSION_GEODATABASE_FILE_2)"
GUI LOOKUP_CHOICE GEODATABASE_FILE_OUT_REQUESTED_GEODATABASE_VERSION_GEODATABASE_FILE_2 Current,CURRENT%10.0%9.3 Geodatabase Version:
# ============================================================================
# This option specifies the starting transaction number. Normally
# this will be zero, which will write every feature to the Geodatabase,
# but it might be another value if a previous translation was interrupted.
DEFAULT_MACRO GEODATABASE_FILE_OUT_TRANSACTION_GEODATABASE_FILE_2 0
GEODATABASE_FILE_2_TRANSACTION "$(GEODATABASE_FILE_OUT_TRANSACTION_GEODATABASE_FILE_2)"
GUI OPTIONAL INTEGER GEODATABASE_FILE_OUT_TRANSACTION_GEODATABASE_FILE_2 Transaction Number:
# ============================================================================
# This option specifies how many features will be written to the Geodatabase on
# each transaction.
DEFAULT_MACRO GEODATABASE_FILE_OUT_TRANSACTION_INTERVAL_GEODATABASE_FILE_2 1000
GEODATABASE_FILE_2_TRANSACTION_INTERVAL "$(GEODATABASE_FILE_OUT_TRANSACTION_INTERVAL_GEODATABASE_FILE_2)"
GUI OPTIONAL INTEGER GEODATABASE_FILE_OUT_TRANSACTION_INTERVAL_GEODATABASE_FILE_2 Features Per Transaction
# ============================================================================
# Determines whether to continue the translation, despite having encountered
# a feature that would normally stop the translation.
DEFAULT_MACRO GEODATABASE_FILE_OUT_IGNORE_FAILED_FEATURE_ENTRY_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_IGNORE_FAILED_FEATURE_ENTRY "$(GEODATABASE_FILE_OUT_IGNORE_FAILED_FEATURE_ENTRY_GEODATABASE_FILE_2)"
GUI OPTIONAL CHOICE GEODATABASE_FILE_OUT_IGNORE_FAILED_FEATURE_ENTRY_GEODATABASE_FILE_2 yes%no Ignore Failed Features:
# ============================================================================
# The number of features to ignore before stopping a translation due to a
# problematic feature. Used only if IGNORE_FAILED_FEATURE_ENTRY is 'yes'.
DEFAULT_MACRO GEODATABASE_FILE_OUT_MAX_NUMBER_FAILED_FEATURES_GEODATABASE_FILE_2 -1
GEODATABASE_FILE_2_MAX_NUMBER_FAILED_FEATURES "$(GEODATABASE_FILE_OUT_MAX_NUMBER_FAILED_FEATURES_GEODATABASE_FILE_2)"
GUI OPTIONAL INTEGER GEODATABASE_FILE_OUT_MAX_NUMBER_FAILED_FEATURES_GEODATABASE_FILE_2 Max number of features to ignore:
# ============================================================================
# Determines whether to store failed features in an FFS file, so that they
# can be viewed/manipulated at a later time. Only applicable if the keyword
# IGNORE_FAILED_FEATURE_ENTRY is set to 'yes'.
DEFAULT_MACRO GEODATABASE_FILE_OUT_DUMP_FAILED_FEATURES_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_DUMP_FAILED_FEATURES "$(GEODATABASE_FILE_OUT_DUMP_FAILED_FEATURES_GEODATABASE_FILE_2)"
GUI OPTIONAL CHOICE GEODATABASE_FILE_OUT_DUMP_FAILED_FEATURES_GEODATABASE_FILE_2 yes%no Dump Failed Features to File:
# ============================================================================
# If the keyword DUMP_FAILED_FEATURES is set to 'yes', determines where to
# store the failed features. The location must specify both the path and the
# filename. The filename must have an extension of 'ffs'.
DEFAULT_MACRO GEODATABASE_FILE_OUT_FFS_DUMP_FILE_GEODATABASE_FILE_2 
GEODATABASE_FILE_2_FFS_DUMP_FILE "$(GEODATABASE_FILE_OUT_FFS_DUMP_FILE_GEODATABASE_FILE_2)"
GUI OPTIONAL FILENAME GEODATABASE_FILE_OUT_FFS_DUMP_FILE_GEODATABASE_FILE_2 FME_Feature_Store_Files(*.ffs)|*.ffs|All_files(*)|* Failed Feature Dump filename:
# ============================================================================
# Specifies the units to use when creating a new annotation feature class.
DEFAULT_MACRO GEODATABASE_FILE_OUT_ANNOTATION_UNITS_GEODATABASE_FILE_2 unknown_units
GEODATABASE_FILE_2_ANNOTATION_UNITS "$(GEODATABASE_FILE_OUT_ANNOTATION_UNITS_GEODATABASE_FILE_2)"
GUI OPTIONAL LOOKUP_CHOICE GEODATABASE_FILE_OUT_ANNOTATION_UNITS_GEODATABASE_FILE_2 "\"Unknown Units\",unknown_units"%"\"Decimal Degrees\",decimal_degrees"%Inches,inches%Points,points%Feet,feet%Yards,yards%Miles,miles%"\"Nautical Miles\",nautical_miles"%Millimeters,millimeters%Centimeters,centimeters%Meters,meters%Kilometers,kilometers%Decimeters,decimeters Annotation Units:
# ============================================================================
# Determines if dataset contains Measures. This value will be used if DEF lines
# don't have anything set.
DEFAULT_MACRO GEODATABASE_FILE_OUT_HAS_MEASURES_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_HAS_MEASURES "$(GEODATABASE_FILE_OUT_HAS_MEASURES_GEODATABASE_FILE_2)"
GUI OPTIONAL CHOICE GEODATABASE_FILE_OUT_HAS_MEASURES_GEODATABASE_FILE_2 yes%no Contains Measures
# ============================================================================
# Determines if the output Geodatabase is to be compacted or not. Note: This
# directive is incorrectly called COMPRESS when in fact it is doing COMPACT.
# Mobile Geodatabase can't do this, so don't expose the parameter.
DEFAULT_MACRO GEODATABASE_FILE_OUT_COMPRESS_AT_END_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_COMPRESS_AT_END "$(GEODATABASE_FILE_OUT_COMPRESS_AT_END_GEODATABASE_FILE_2)"
GUI OPTIONAL CHOICE GEODATABASE_FILE_OUT_COMPRESS_AT_END_GEODATABASE_FILE_2 yes%no Compact Database When Done:
# ============================================================================
# Enable fast deletes which will combine the WHERE clause (delete) conditions
# and only create one query to the table per transaction
DEFAULT_MACRO GEODATABASE_FILE_OUT_ENABLE_FAST_DELETES_GEODATABASE_FILE_2 yes
GEODATABASE_FILE_2_ENABLE_FAST_DELETES "$(GEODATABASE_FILE_OUT_ENABLE_FAST_DELETES_GEODATABASE_FILE_2)"
GUI CHOICE GEODATABASE_FILE_OUT_ENABLE_FAST_DELETES_GEODATABASE_FILE_2 yes%no Enable Fast Deletes:
# ============================================================================
# Preserve GlobalIDs
DEFAULT_MACRO GEODATABASE_FILE_OUT_PRESERVE_GLOBALID_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_PRESERVE_GLOBALID "$(GEODATABASE_FILE_OUT_PRESERVE_GLOBALID_GEODATABASE_FILE_2)"
GUI CHOICE GEODATABASE_FILE_OUT_PRESERVE_GLOBALID_GEODATABASE_FILE_2 yes%no Preserve GlobalID:
# ============================================================================
# Enable Load Only Mode when inserting features. This will disable updating of the spatial index
# while data is loading, and rebuild the index after writing is done.
DEFAULT_MACRO GEODATABASE_FILE_OUT_ENABLE_LOAD_ONLY_MODE_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_ENABLE_LOAD_ONLY_MODE "$(GEODATABASE_FILE_OUT_ENABLE_LOAD_ONLY_MODE_GEODATABASE_FILE_2)"
GUI CHOICE GEODATABASE_FILE_OUT_ENABLE_LOAD_ONLY_MODE_GEODATABASE_FILE_2 yes%no Enable Load Only Mode:
# ============================================================================
# When enabled, the user will be allowed to write to attributed relationships directly.
DEFAULT_MACRO GEODATABASE_FILE_OUT_RELATIONSHIP_WRITE_OVERRIDE_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_RELATIONSHIP_WRITE_OVERRIDE "$(GEODATABASE_FILE_OUT_RELATIONSHIP_WRITE_OVERRIDE_GEODATABASE_FILE_2)"
GUI CHOICE GEODATABASE_FILE_OUT_RELATIONSHIP_WRITE_OVERRIDE_GEODATABASE_FILE_2 yes%no Override Relationship Writing:
# ============================================================================
# Determines whether to perform validation on features being written to the
# geodatabase. Default is no.
DEFAULT_MACRO GEODATABASE_FILE_OUT_VALIDATE_FEATURES_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_VALIDATE_FEATURES "$(GEODATABASE_FILE_OUT_VALIDATE_FEATURES_GEODATABASE_FILE_2)"
GUI OPTIONAL CHOICE GEODATABASE_FILE_OUT_VALIDATE_FEATURES_GEODATABASE_FILE_2 yes%no Validate Features to Write:
# ============================================================================
# Determines whether to perform simplification on network features being
# written to the geodatabase. Default is no.
DEFAULT_MACRO GEODATABASE_FILE_OUT_SIMPLIFY_NETWORK_FEATURES_GEODATABASE_FILE_2 no
GEODATABASE_FILE_2_SIMPLIFY_NETWORK_FEATURES "$(GEODATABASE_FILE_OUT_SIMPLIFY_NETWORK_FEATURES_GEODATABASE_FILE_2)"
GUI OPTIONAL CHOICE GEODATABASE_FILE_OUT_SIMPLIFY_NETWORK_FEATURES_GEODATABASE_FILE_2 yes%no Simplify Network Features:
# ==============================================================================
# The following specifies an SQL command to execute before opening the first
# Geodatabase table.
DEFAULT_MACRO GEODATABASE_FILE_OUT_BEGIN_SQL{0}_GEODATABASE_FILE_2 
GEODATABASE_FILE_2_BEGIN_SQL{0} "$(GEODATABASE_FILE_OUT_BEGIN_SQL{0}_GEODATABASE_FILE_2)"
GUI OPTIONAL TEXT_EDIT_SQL_CFG GEODATABASE_FILE_OUT_BEGIN_SQL{0}_GEODATABASE_FILE_2 MODE,SQL;FORMAT,GEODATABASE_FILE SQL To Run Before Write
# ==============================================================================
# The following specifies an SQL command to execute after closing all the
# Geodatabase tables.
DEFAULT_MACRO GEODATABASE_FILE_OUT_END_SQL{0}_GEODATABASE_FILE_2 
GEODATABASE_FILE_2_END_SQL{0} "$(GEODATABASE_FILE_OUT_END_SQL{0}_GEODATABASE_FILE_2)"
GUI OPTIONAL TEXT_EDIT_SQL_CFG GEODATABASE_FILE_OUT_END_SQL{0}_GEODATABASE_FILE_2 MODE,SQL;FORMAT,GEODATABASE_FILE SQL To Run After Write
# ============================================================================
# Opt in for destination dataset type vs format type validation
DEFAULT_MACRO GEODATABASE_FILE_OUT_DESTINATION_DATASETTYPE_VALIDATION_GEODATABASE_FILE_2 Yes
GEODATABASE_FILE_2_DESTINATION_DATASETTYPE_VALIDATION "$(GEODATABASE_FILE_OUT_DESTINATION_DATASETTYPE_VALIDATION_GEODATABASE_FILE_2)"
DEFAULT_MACRO GEODATABASE_FILE_OUT_COORDINATE_SYSTEM_GRANULARITY_GEODATABASE_FILE_2 FEATURE_TYPE
GEODATABASE_FILE_2_COORDINATE_SYSTEM_GRANULARITY "$(GEODATABASE_FILE_OUT_COORDINATE_SYSTEM_GRANULARITY_GEODATABASE_FILE_2)"
# ==============================================================================
# This keyword determines whether we enable creating tables when only receiving
# a schema feature or not receiving any data.
DEFAULT_MACRO GEODATABASE_FILE_OUT_ALWAYS_CREATE_FEATURE_TYPES_GEODATABASE_FILE_2 NO
GEODATABASE_FILE_2_ALWAYS_CREATE_FEATURE_TYPES "$(GEODATABASE_FILE_OUT_ALWAYS_CREATE_FEATURE_TYPES_GEODATABASE_FILE_2)"
GUI LOOKUP_CHOICE GEODATABASE_FILE_OUT_ALWAYS_CREATE_FEATURE_TYPES_GEODATABASE_FILE_2 YES,YES%NO,NO Always Create Tables
